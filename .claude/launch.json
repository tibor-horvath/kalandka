{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "dev-auto",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "require('child_process').spawn('npx',['vite','--port',process.env.PORT||'5190','--strictPort'],{stdio:'inherit',shell:true})"
      ],
      "port": 5190,
      "autoPort": true
    }
  ]
}